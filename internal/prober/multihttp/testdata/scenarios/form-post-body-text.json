{
  "description": "One form POST checks the reply text.",
  "settings": {
    "entries": [
      {
        "request": {
          "method": "POST",
          "url": "{{base}}/search",
          "body": {"contentType": "application/x-www-form-urlencoded", "payload": "cT1hbHBoYSZwYWdlPTE="}
        },
        "checks": [{"type": 0, "subject": 3, "value": "results for alpha"}]
      }
