{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiServerAddress": {
          "type": "string"
        },
        "apiToken": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "apiInsecure": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbose": {
          "type": "boolean"
        },
        "debug": {
          "type": "boolean"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "enum": [
          "experimental-dns-prober",
          "protocol-secrets"
        ]
      },
      "uniqueItems": true
    },
    "listenPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "k6": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "blockedNets": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoMemLimit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "memLimitRatio": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            null,
            "auto",
            "memcached",
            "local",
            "noop"
          ]
        },
        "localCapacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "localTTL": {
          "type": [
            "string",
            "null"
          ]
        },
        "memcachedServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "usageReports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": {
          "type": "boolean"
        },
        "timeSpan": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "metricsPushInterval": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "debugEndpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changeLogLevel": {
          "type": "boolean"
        },
        "disconnect": {
          "type": "boolean"
        },
        "pprof": {
          "type": "boolean"
        },
        "blockProfileRate": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mutexProfileFraction": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "listenPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "waitForSize": {
          "type": "integer",
          "minimum": 0
        },
        "waitTimeout": {
          "type": [
            "string",
            "null"
          ]
        },
        "rejoinInterval": {
          "type": [
            "string",
            "null"
          ]
        },
        "advertiseAddress": {
          "type": "string"
        },
        "extraJoinAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "browserPool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalAddresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "standard",
            "browser"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraPodSecurityContext": {
      "type": "object"
    },
    "extraSecurityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "readinessProbe": {
      "type": [
        "object",
        "null"
      ]
    },
    "livenessProbe": {
      "type": [
        "object",
        "null"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "lifecycle": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "hostAliases": {
      "type": "array"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsIngressFrom": {
          "type": "array"
        },
        "clusterIngressFrom": {
          "type": "array"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "relabelings": {
          "type": "array"
        },
        "metricRelabelings": {
          "type": "array"
        }
      }
    },
    "crocochrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "replicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "readinessProbe": {
          "type": [
            "object",
            "null"
          ]
        },
        "livenessProbe": {
          "type": [
            "object",
            "null"
          ]
        },
        "extraPodSecurityContext": {
          "type": "object"
        },
        "extraSecurityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "tmpSizeLimit": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraIngressFrom": {
              "type": "array"
            },
            "egress": {
              "type": "array"
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            }
          }
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      }
    }
  }
}
